# Copy to ~/.outreach-desk/.env (or ./.env) and fill in.

# Claude writes the drafts. Required.
ANTHROPIC_API_KEY=
# OUTREACH_DESK_MODEL=claude-opus-5-5

# Jev makes the decisions. Optional: without it, Claude Haiku answers the same questions.
TYPESAFE_API_KEY=

# Sending (SMTP) and replies (IMAP). Use an app password, ideally on a secondary address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
FROM_NAME=Your Name

# Guard rails
DAILY_CAP=30
SEND_WINDOW=8-19
# Required for sales mode (CAN-SPAM): your physical postal address.
POSTAL_ADDRESS=
